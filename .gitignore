__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/

# Source datasets remain local unless explicitly curated into Git.

# Model weights / checkpoints: never track, regardless of where they land.
# Directory-level rule covers the current save_pretrained() output path;
# extension rules are defense-in-depth if that path ever changes.
runs/**/lora/
# Adapters may be relocated to the large volume with a symlink left behind
# (see docs/storage.md); the trailing-slash rule above only matches directories.
runs/**/lora
# Latest-only training checkpoint (model.py::LoRA.fit(), overwritten every epoch
# for resume-after-interruption); .tmp is the write-then-atomic-rename staging dir.
runs/**/checkpoint/
runs/**/checkpoint.tmp/
*.safetensors
*.ckpt
*.pt
*.bin

# Training artifacts: retain metrics (some tracked via Git LFS, see
# .gitattributes), exclude logs and the unused layer_norms diagnostic dump.
logs/
layer_norms.jsonl

# Smoke-test output: `train --smoke` writes here (train.py:5), 64 samples and
# 8 steps just to prove the wiring works. Never an experimental result.
runs/*/_smoke/

# Per-question eval records: written by evaluate.py:368 and read by nothing.
# The aggregate accuracies the report actually cites live in eval_{tag}_{ds}.json,
# a few hundred KB against ~100MB for these.
results/eval/eval_raw_*.jsonl

# TensorBoard event files: write-only (model.py:223), never read by any
# analysis, and a lossier encoding of what per_sample.jsonl already holds.
# Filenames embed the container id and pid of the machine that produced them.
runs/**/tb/

# Orchestration shell scripts (run_full.sh etc.): operational tooling tied
# to specific runs/tags, not part of the tracked codebase deliverable.
/*.sh
/scripts/

# Datasets held on the large volume and reached through a symlink; the pointer
# is machine-specific, and wild_data.py rebuilds the contents from OASST.
datasets/wild_all

# Comparison-method / external-baseline code: kept local only, never pushed.
/baselines.py

# Personal Claude Code config, not a project deliverable.
/CLAUDE.md
/.claude/
